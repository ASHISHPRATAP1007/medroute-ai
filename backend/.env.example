# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME=MedRoute AI
# Set to "production" when deployed: enforces a strong JWT_SECRET and
# blocks the demo seed.
APP_ENV=development

# postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
# A plain postgres:// or postgresql:// URL (Render, Neon, Supabase) also works —
# it is converted automatically, including ?sslmode=require.
DATABASE_URL=postgresql+asyncpg://medroute:medroute@localhost:5432/medroute

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-to-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins, e.g.
# CORS_ORIGINS=https://medroute.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# What "today" means for visits (missed visits, follow-ups).
APP_TIMEZONE=Asia/Kolkata

# --- First run (python -m app.bootstrap — the Docker image runs it on start) ---
# Creates this SUPER_ADMIN if none exists yet. Use a real email + strong password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_PHONE=9000000000
# true = also load the public demo dataset (Demo@1234 accounts). Ignored in production.
SEED_DEMO_DATA=false

LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute

# --- Google Places (optional — leave disabled if you don't have a key) ---
# Enable "Places API (New)" in Google Cloud (the legacy Places API can't be
# enabled on new projects), link billing, and restrict the key to that API.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_CACHED_REVIEWS=5
