# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME=MedRoute AI
APP_ENV=development

# postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+asyncpg://medroute:medroute@localhost:5432/medroute

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-to-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000

LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute

# --- Phase 2: Google Places (optional — leave disabled if you don't have a key) ---
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_CACHED_REVIEWS=5
